# player_can_play
# IN: Games::Cards::Hand	Games::Cards::Card
## OUT: bool
# OUT: ref to an array of card faces
sub player_can_play
{
	my ($player_hand, $real_top_card, $displayed_suit) = @_;
	my $playable = [];

	my $top_name;
	my $top_suit;
	my $available_moves = Games::Cards::Hand->new ($Game, 'a_moves');
	my $clone_card;

	if (defined $player_hand and $player_hand->isa ('Games::Cards::Hand') and
		defined $real_top_card and $real_top_card->isa ('Games::Cards::Card'))
	{
		my @card_part = split //, $top_card;
		_log ("tCP: [".(join '/',@card_part)."]");
		$top_suit = $card_part[$#card_part - 1];
		_log ("Fts: $top_suit");
		if ($top_suit ne $real_top_card->suit ())
		{
			_log ("[Ts:$top_suit != RTCs:".$real_top_card->suit ()."] use fake suit");
		}

		_log ("TCn: ".$real_top_card->name ()."\tTCs: $top_suit");

		for my $card (@{$player_hand->cards})
		{
			if ($card->name () eq '8' or
				$real_top_card->name () eq $card->name () or
				$top_suit eq $card->suit ())
			{
				_log ('['.$card->print ()."] Cs: ".$card->suit ()."\tCn: ".$card->name ()."  *");
				$card->face_up ();
				push @{$playable}, $card->print ();   #$card->name ().$card->suit ();
				$card->face_down ();
				$clone_card = $card->clone ($Game);
				$clone_card->set_owning_cardset ($available_moves);
				push @{$available_moves->cards}, $clone_card;	# little hack to add card to given cardset
			}
			else
			{
				_log ("Cs: ".$card->suit ()."\tCn: ".$card->name ());
			}
		}
	}
	else
	{
		_log ($ERROR, 'Invalid player hand/card given !');
	}

	_log ($INFO, "Playable cards: ".$#{$playable});
	$playable;
}


# IN: player's hand
# OUT: hash of suits which values are suits members count
sub _get_suits_count
{
	my ($hand, $ignored_card) = @_;
	my $count = 
		{
			'C' => 0,
			'D' => 0,
			'H' => 0,
			'S' => 0,
			max => ''
		};

	if (defined $hand and $hand->isa ('Games::Cards::Hand'))
	{
		for my $card (@{$hand->cards ()})
		{
			if (defined $ignored_card and $ignored_card->isa ('Games::Cards::Card'))
			{
				if ($ignored_card->name () eq $card->name () and
					$ignored_card->suit () eq $card->suit ())
				{
					_log ('Ignore card :'.$ignored_card->print ().'in suit count');
					next;
				}
			}
			$count->{$card->suit ()}++;
			$count->{max} = $card->suit () if ($count->{$card->suit ()} > $count->{max});
			_log ('Cs: '.$card->suit ().'=> '.$count->{$card->suit ()});
		}
	}
	else
	{
		_log ($ERROR, 'Invalid hand given!');
	}

	$count;
}


# IN : [suit]
# OUT: highest value in this suit/for all suits in hand
sub _highest_card
{
	my ($hand, $suit) = @_;

	my $highest_value = 0;
	my $highest;

	if (defined $hand and $hand->isa ('Games::Cards::Hand') and
		defined $suit and $suit =~ /^C|D|H|S$/i)
	{
		for my $card (@{$hand->cards ()})
		{
			if ($card->suit () =~ /$suit/i)
			{
				if ($highest_value < $card->value ())
				{
					$highest_value = $card->value ();
					$card->face_up ();
					$highest = $card->print ();
					_log ('C: '.$card->print ()."=> $highest_value");
					$card->face_down ();
				}
			}
		}
	}
	else
	{
		print "Error: invalid hand/suit given!\n";
	}

	$highest;
}


# IN : [suit]
# OUT: lowest value in this suit/for all suits in hand
sub _lowest_card
{
	my ($hand, $suit) = @_;

	my $lowest_value = 55;
	my $lowest;

	if (defined $hand and $hand->isa ('Games::Cards::Hand') and
		defined $suit and $suit =~ /^C|D|H|S$/i)
	{
		for my $card (@{$hand->cards ()})
		{
			if ($card->suit () =~ /$suit/i)
			{
				if ($lowest_value > $card->value ())
				{
					$lowest_value = $card->value ();
					$lowest = $card->print ();
					_log ('C: '.$card->print ()."=> $lowest_value");
				}
			}
		}
	}
	else
	{
		print "Error: invalid hand/suit given!\n";
	}

	$lowest;
}


sub _have_more_card_than_others
{
	my $computer = shift;
	my $have_more_cards = 0;

	_log ('_have_more_card_than_others called');

	my $cards = $players->[$computer]->hand ()->size ();

	for my $count (0 .. $CONFIG->{number_of_players} - 1)
	{
		next if ($count == $computer);
		if ($cards > $players->[$count]->hand ()->size ())
		{
			$have_more_cards = 1;
			last;
		}
	}

	_log ("Result: $have_more_cards");
	$have_more_cards;
}


sub _have_less_card_than_others
{
	my $computer = shift;
	my $have_less_cards = 0;

	_log ('_have_less_card_than_others called');

	my $cards = $players->[$computer]->hand ()->size ();

	for my $count (0 .. $CONFIG->{number_of_players} - 1)
	{
		next if ($count == $computer);
		if ($cards < $players->[$count]->hand ()->size ())
		{
			$have_less_cards = 1;
			last;
		}
	}

	_log ("Result: $have_less_cards");
	$have_less_cards;
}


sub _choose_a_suit
{
	my ($hand, $played_card) = @_;
	my $suit;

	if (defined $hand and $hand->isa ('Games::Cards::Hand'))
	{
		if ($hand->size () == 1)
		{
			_log ("Computer player have only one card in hand, suit is this card's suit");
			$suit = @{$hand->cards ()}[0]->suit ();
		}
		else
		{
			my $suit_count = _get_suits_count ($hand, $played_card);
			use Data::Dumper;	#tmp
			_log ("suit count hash: ".Dumper ($suit_count));
			# HERE: AI different behavior: max/min/high value/...
			$suit = $suit_count->{max};
			_log ("Computer player choose: $suit");
		}
	}
	else
	{
		_log ($ERROR, "Hand is not defined or invalid");
	}

	$suit;
}


