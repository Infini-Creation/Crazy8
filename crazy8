sub init_players
{
	my $players = [];

	_log ($DEBUG, "Players list: ".$CONFIG->{players});
	my @players_list = split /,/, $CONFIG->{players};

	if ($#players_list != $CONFIG->{number_of_players} - 1)
	{
		_log ($WARN, "players list items count doesn't match defined number of players.");

		$CONFIG->{number_of_players} = $#players_list + 1;
		_log ($DEBUG, "number_of_players set to: ".$CONFIG->{number_of_players});
	}

	my $count = 0;
	map
	{
		my ($type, $name) = split /\|/;
		_log ($DEBUG, "Item: $_\tType: $type\tName:$name");
		$players->[$count++] = Games::Player->new (name => $name, kind => $type);
	} @players_list;

	$players;
}

# ---- internal ----

sub _validate_config
{
	if ($CONFIG->{number_of_players} < 0 or $CONFIG->{number_of_players} > MAX_PLAYERS)
	{
		$CONFIG->{number_of_players} = MAX_PLAYERS;
	}
	if ($CONFIG->{first_player}-- < 0 or $CONFIG->{first_player} > $CONFIG->{number_of_players} - 1)
	{
		$CONFIG->{first_player} = DEFAULT_FIRST_PLAYER;
	}
	if ($CONFIG->{max_score} < MIN_SCORE or $CONFIG->{max_score} > MAX_SCORE)
	{
		$CONFIG->{max_score} = MIN_SCORE;
	}
	if ($CONFIG->{score_kind} != SCORE_KIND_HIGHEST or $CONFIG->{score_kind} != SCORE_KIND_LOWEST)
	{
		$CONFIG->{score_kind} = SCORE_KIND_LOWEST;
	}
	if ($CONFIG->{computer_opponents_level} < COMPUTER_MIN_LEVEL or $CONFIG->{computer_opponents_level} > COMPUTER_MAX_LEVEL)
	{
		$CONFIG->{computer_opponents_level} = DEFAULT_COMPUTER_LEVEL;
	}
	if ($CONFIG->{game_speed} < MIN_SPEED or $CONFIG->{game_speed} > MAX_SPEED)
	{
		$CONFIG->{game_speed} = DEFAULT_GAME_SPEED;
	}
	if ($CONFIG->{auto_sort} < 0 or $CONFIG->{auto_sort} > 2)
	{
		$CONFIG->{auto_sort} = DEFAULT_SORT_OPTION;
	}
}


sub _init_logfile
{
	return 0 if ($CONFIG->{no_log} or $log4perl_not_available);

	eval
	{
		$Log::Log4perl::caller_depth++;
		$_logger = Log::Log4perl::get_logger ("Game");

		if (defined $CONFIG->{logfile} and length $CONFIG->{logfile} > 5 and -w basename ($CONFIG->{logfile}))
		{
			$l4p_init->{'log4perl.appender.File.filename'} = $CONFIG->{logfile};
		}
		else
		{
			print STDERR "Wrong setting for logile: [".$CONFIG->{logfile}."], use default\n";
		}

		Log::Log4perl::init($l4p_init);
	};
	if ($@)
	{
		print "ERROR $@\n" unless ($log4perl_not_available);
	}
}


sub _close_logfile
{
	if (defined $_logger)
	{
		_log ('Remove logger');
		undef $_logger;
	}
}


sub _log
{
	my ($level, $message) = @_;

    if (!defined $message and defined $level)
    {
        $message = $level;
        $level = $DEBUG;
    }

    chomp $message;

	if (defined $_logger and $_logger->isa ('Log::Log4perl::Logger'))
	{
		$_logger->log ($level, $message);
	}
}


sub _today
{
    my @date = localtime;
    my $month = $date[4]+1;
    my $year = $date[5]+1900;

    $year.sprintf ("%02d",$month).sprintf("%02d",$date[3]);
}


sub _time
{
    my $format = shift;

    my @date = localtime;
    sprintf (($format || "%02d%02d%02d"),$date[2], $date[1], $date[0]);
}


