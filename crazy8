sub play_card
{
	my $card_index = shift;
	my $card_name;

	_log ($DEBUG, 'play_card called');

	if (defined $card_index and $card_index !~ /^\d{1,2}$/)
	{
		$card_name = $card_index;
		$card_index = $players->[$current_player - 1]->hand ()->index ($card_name);
		_log ("Get I:$card_index => N:$card_name\n");
	}
	else
	{
		$card_index--;

		$card_name =  $players->[$current_player - 1]->hand ()->name ($card_name);
		_log ("Get I:$card_index => N:$card_name\n");
	}

	if ($card_index < 0 or $card_index > $players->[$current_player - 1]->hand ()->size () - 1)
	{
		_log ("Wrong card played: CI=$card_index/HS=".$players->[$current_player - 1]->hand ()->size ());
		print "Wrong card !\n";
		return 0;
	}
	else
	{
		my $player_cards = $players->[$current_player - 1]->hand ()->cards ();
		unless (is_legal ($player_cards->[$card_index], $discard->top_card ()))
		{
			print "Wrong card played!\n";
			if ($CONFIG->{auto_take_card})
			{
				#print "You must take a card from stock !\n";
				&take_a_card;
			}
			return 0;
		}
		else
		{
			my $new_suit = 0;

			_log ("play card #$card_index\n");
			$player_cards->[$card_index]->face_up ();
			print "Play: [$card_index] ".$player_cards->[$card_index]->print ()."\n";

			if ($player_cards->[$card_index]->name () eq '8')
			{
				_log ('Play an 8');
				while ($new_suit !~ /C|D|H|S/i)
				{
					if ($players->[$current_player - 1]->is_human ())
					{
						print "New suit ?";
						$new_suit = <STDIN>;
						chomp $new_suit;
						$new_suit = uc $new_suit;
						_log ("Human player choose: $new_suit");
					}
					else
					{
						$new_suit = _choose_a_suit ($players->[$current_player - 1]->hand (), $player_cards->[$card_index]);

						_log ("Computer player choose: $new_suit");
					}
				}
				_log ("Suit choosen: $new_suit\n");
			}

			$players->[$current_player - 1]->hand ()->give_a_card ($discard, $card_index);

			$top_card = $discard->top_card ()->print ();
			$top_card =~ s/(C|D|H|S)/$new_suit/i if ($new_suit);
			_log ("Top card: $top_card");
		}
	}

	1;
}


sub rebuild_stock
{
	print "rebuild stock pile\n";
	_log ("rebuild stock pile");

	if ($store->size == 0)
	{
		if ($discard->size > 0)
		{
			# keep top card of discard pile
			my $display = Games::Cards::Stack->new ($Game, 'temp');
			$discard->give_cards ($display, 1);

			_log ("Display: ".$display->top_card ()->print ('short')."\n");

			_log ("D:dc_sz: ".$discard->size ()."    st_sz:".$store->size ()."\n");
			$discard->give_cards ($store, 'all');
			_log ("D:dc_sz: ".$discard->size ()."    st_sz:".$store->size ()."\n");

			print "Shuffle store\n";
			_log ("Shuffle store\n");
			$store->shuffle;

			_log ("D:dis_sz: ".$display->size ()."    dc_sz:".$discard->size ()."\n");
			$display->give_cards ($discard, 'all');
			_log ("D:dis_sz: ".$display->size ()."    dc_sz:".$discard->size ()."\n");
		}
		else
		{
			print "Discard pile is empty, skip your turn !\n";
			# need something here
		}
	}
	else
	{
		print "ERROR: store isn't empty !\n";
		_log ($ERROR, "store isn't empty !");
	}
}


sub is_legal
{
	my ($card, $real_top_card) = @_;

	my $legal = 0;
	my $top_name;
	my $top_suit;

	if (defined $card and $card->isa ('Games::Cards::Card') and
		defined $real_top_card and $real_top_card->isa ('Games::Cards::Card'))
	{
		$top_suit = $real_top_card->suit ();
		_log ("Rts: $top_suit");
		_log ("Tcard: $top_card");

		my @card_part = split //, $top_card;
		_log ("CP: [".(join '/',@card_part)."]");
		$top_suit = $card_part[$#card_part - 1];
		_log ("\tFts: $top_suit");
		if ($top_suit ne $real_top_card->suit ())
		{
			_log ("use fake suit: $top_suit");
		}

		_log ('N:'.$card->name ().'  S:'.$card->suit ());
		_log ("TCn: ".$real_top_card->name ()."\tTCs: $top_suit");

		if ($card->name () eq '8' or
			$real_top_card->name () eq $card->name () or
			$top_suit eq $card->suit ())
		{
			$legal = 1;
		}
	}
	else
	{
		print "Error: invalid card object !\n";
	}

	$legal;	
}


sub take_a_card
{
	my $recursive_count = shift;

	if (defined $store and $store->isa ('Games::Cards::Queue') and 
		defined $players and ref $players eq 'ARRAY' and
		defined $players->[$current_player - 1] and $players->[$current_player - 1]->isa ('Games::Player') and
		$players->[$current_player - 1]->hand ()->isa ('Games::Cards::Hand') )
	{
		unless ($store->give_cards ($players->[$current_player - 1]->hand (), 1) == 1)
		{
			&rebuild_stock;

			$recursive_count = defined $recursive_count ? $recursive_count++ : 1;
			if ($recursive_count > MAXIMUM_RECURSIVE_CALL)
			{
				_log ($DEBUG, "RC: $recursive_count > ".MAXIMUM_RECURSIVE_CALL);
				_log ($ERROR, "maximum recursive call reach, break loop !");
			}
			else
			{
				_log ($DEBUG, "Call again take_a_card ($recursive_count)");
				take_a_card ($recursive_count);
			}
		}

		my $cards = $players->[$current_player - 1]->hand ()->cards ();

		if (defined $cards and ref $cards eq 'ARRAY' and
			defined $cards->[$#{$cards}] and
			$cards->[$#{$cards}]->isa ('Games::Cards::Card') )
		{
			print '['.$current_player.'] Get a card';
			if ($players->[$current_player - 1]->is_human ())
			{
				print ": ".$cards->[$#{$cards}]->print ();
			}
			print "\n";
		}
		else
		{
			print "Error: invalid player cards hand !\n";
		}

		if ($CONFIG->{auto_sort})
		{
			sort_my_hand ($CONFIG->{auto_sort});
		}
	}
	else
	{
		print "Error: invalid queue store or player hand !\n";
	}
}


sub sort_my_hand
{
	my $sort_option = shift;
	_log ("Sort opt: $sort_option") if (defined $sort_option);

	if (defined $players and ref $players eq 'ARRAY' and
		defined $players->[$current_player - 1] and
		$players->[$current_player - 1]->isa ('Games::Player') and
		$players->[$current_player - 1]->hand ()->isa ('Games::Cards::Hand'))
	{
		$sort_option = 0 unless (defined $sort_option);

		if ($sort_option == 1)
		{
			_log ('Hand sorted by suit');
			$players->[$current_player - 1]->hand ()->sort_by_suit ();
		}
		elsif ($sort_option == 2)
		{
			_log ('Hand sorted by value');
			$players->[$current_player - 1]->hand ()->sort_by_value ();
		}
		else
		{
			_log ('Hand sorted by suit and value');
			$players->[$current_player - 1]->hand ()->sort_by_suit_and_value ();
		}
	}
	else
	{
		print "ERROR: invalid players array/Hand\n";
	}
}


sub skip_turn
{
	my $moves = player_can_play ($players->[$current_player - 1]->hand (), $discard->top_card ());
	unless ($#{$moves} > -1)
	{
		print "skip\n";
		return 1;
	}
	else
	{
		print "You must play !\n";
	}
}


sub check_for_winner
{
	return 1 if (defined $players and ref $players eq 'ARRAY' and
				defined $players->[$current_player - 1] and
				$players->[$current_player - 1]->isa ('Games::Player') and
				$players->[$current_player - 1]->hand ()->isa ('Games::Cards::Hand') and
				$players->[$current_player - 1]->hand ()->size () == 0);
}


