sub initialize_match
{
	print "Initialize match...\n";
	_log ($INFO, '-' x 80);
	_log ($INFO, 'Initialize match...');

	undef $Deck;
	undef $store;
	undef $discard;

	$Deck = Games::Cards::Deck-> new ($Game, 'deck');
	$store = Games::Cards::Queue-> new ($Game, 'store');
	$discard = Games::Cards::Stack-> new ($Game, 'discard');

	$Deck->shuffle;

	for my $count (0 .. $CONFIG->{number_of_players} - 1)
	{
		$players->[$count]->hand (Games::Cards::Hand->new ($Game, 'player'.($count+1)));
		
		$Deck->give_cards ($players->[$count]->hand (), 5);
	}

	$Deck->give_cards ($store, 'all');

	$store->give_cards ($discard, 1);
	$top_card = $discard->top_card ()->print ();

	$undo_buffer->end_move ();
}


sub calc_score
{
	my $hand = shift;
	my $score = 0;

	if (defined $hand and $hand->isa ('Games::Cards::Hand'))
	{
		my $cards_in_hand = $hand->cards;
		for my $card (@{$cards_in_hand})
		{
			$score += $card->value if (defined $card and $card->isa ('Games::Cards::Card'));
		}
	}

	$score;
}


sub high_score
{
	my $high_score = 0;

	for my $count (0 .. $CONFIG->{number_of_players} - 1)
	{
		if (defined $players->[$count] and $players->[$count]->isa ('Games::Player'))
		{
			$high_score = $players->[$count]->score () if ($players->[$count]->score () > $high_score);
		}
	}

	$high_score;
}


sub display_game
{
	print "\tScore :\t";
	for my $count (0 .. $CONFIG->{number_of_players} - 1)
	{
		print ''.$players->[$count]->name ().': '.$players->[$count]->score ().'  ';
	}

	print "\n\n\tD:[$top_card]\t Ss: [".$store->size."]\n\n";

	for my $count (0 .. $CONFIG->{number_of_players} - 1)
	{
		$players->[$count]->hand ()->face_down () if ($players->[$count]->is_not_human ());

		my $array_of_cards = $players->[$count]->hand()->cards;
		my $card_count = 0;
		my $string_to_print = join ' ', map {$card_count++; "$card_count:".$_->print ('short')} @{$array_of_cards};

		print 'P'.($count + 1).' ('.$players->[$count]->hand ()->size ()."): $string_to_print\n\n";
	}

	print "\n";
}


sub process_user_command
{
	my $input = shift;
	my $end_turn = 0;

	if (defined $input)
	{
		$input =~ s/^\s+//;
		$input =~ s/\s+$//;

		if ($input =~ /^(?:h|\?|help)$/i)
		{
			&help;
		}
		elsif ($input =~ /^(?:k|skip)$/i)
		{
			$end_turn = 1 if (&skip_turn);
		}
		elsif ($input =~ /^load$/i)
		{
			#load games/players
		}
		elsif ($input =~ /^(?:q|quit|bye)$/i)
		{
			&quit;
		}
		elsif ($input =~ /^(?:r|redo)$/i)
		{
			&redo;
		}
		elsif ($input =~ /^save$/i)
		{
			#save game/players
		}
		elsif ($input =~ /^(?:s|sort)\s*(.*)$/i)
		{
			sort_my_hand ($1); # opt: suit/value/suit & value
			$undo_buffer->end_move ();
		}
		elsif ($input =~ /^(?:t|take)$/i)
		{
			&take_a_card;
			$undo_buffer->end_move ();
		}
		elsif ($input =~ /^(?:u|undo)$/i)
		{
			&undo;
		}
		elsif (length $input > 0 and ($input =~ /^\d{1,2}$/ or $input =~ /^(\d{1,2}|A|J|Q|K)(C|D|H|S)$/i))
		{
			if (play_card ($input) == 1)
			{
				$undo_buffer->end_move ();
				$end_turn = 1;
			}
		}
		else
		{
			print "Unknow command !\n";
		}
	}

	$end_turn;
}


